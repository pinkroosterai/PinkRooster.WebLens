# Copy to .env (gitignored) next to compose.yml. Secrets live only there.

# SHA-256 (hex) of the owner's API key. The key itself is never stored here: printf '%s' "$KEY" | sha256sum
WEBLENS_API_KEY_SHA256=

# The private Valkey's password: openssl rand -hex 32
VALKEY_PASSWORD=

# Roll back by pinning a published short sha instead of `current`.
IMAGE_TAG=current

# SearXNG as the app reaches it over weblens-search. Its JSON output format must be enabled.
SEARXNG_URL=http://searxng:8080

# Measured with deploy/load-check.sh: the browser idles at ~250 MiB and needs ~140 MiB per busy context.
# 3 contexts fit the 1536m limit with headroom.
MAX_CONCURRENT_CONTEXTS=3
APP_MEMORY_LIMIT=1536m
